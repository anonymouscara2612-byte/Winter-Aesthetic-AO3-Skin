}

div.favorite.module {
  padding: 10px;
  box-sizing: border-box;
  border-radius: 10px;
  background: rgba(14, 16, 20, 0.7);
  box-shadow: none;
}

.splash .favorite li:nth-of-type(2n+1) a,
.splash .favorite li:nth-of-type(2n+2) a {
  background: rgba(14, 16, 20, 0.5);
  border-radius: 10px;
  color: #EAEDF2;
}

.splash .favorite li:nth-of-type(2n+1) a::before,
.splash .favorite li:nth-of-type(2n+2) a::before {
  content: " 🎀 ";
  color: transparent !important;
  text-shadow: 0 0 0 #EAEDF2;
}

.splash .favorite li:nth-of-type(2n+1) a:hover,
.splash .favorite li:nth-of-type(2n+2) a:hover {
  background: #0E1014;
  color: #DEE8D3 !important;
}

.splash .favorite li:nth-of-type(2n+1) a:hover::before,
.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " ⛸️ ";
  color: transparent !important;
  text-shadow: 0 0 0 #DEE8D3;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-25%);
  width: 80px;
  height: 91px;
  background-image: url("https://64.media.tumblr.com/008838ee8c29085b93f3aed9052621a9/1560ae7e27ce0ab0-5b/s1280x1920/2ec28cfb34e2df396502e0d0212aa0d9a466123e.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝓔𝓿𝓮𝓻𝔂𝓽𝓱𝓲𝓷𝓰'𝓼 𝓶𝓪𝓰𝓲𝓬𝓪𝓵 𝔀𝓱𝓮𝓷 𝓲𝓽 𝓼𝓷𝓸𝔀𝓼...";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(14, 16, 20, 0.7);
  text-align: center;
  font-size: 14px;
  color: #EAEDF2;
  opacity: 1;
  white-space: pre;
}

.news.index.group li.post.group {
